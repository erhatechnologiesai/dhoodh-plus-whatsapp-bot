# ==============================================================================
# DHOODH PLUS AI WHATSAPP BOT - AWS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENV=production
APP_NAME="Dhoodh Plus WhatsApp AI Agent"
SECRET_KEY=generate_a_random_32_character_secret_key_here
ADMIN_PASSWORD=change_this_admin_password_in_production

# ------------------------------------------------------------------------------
# 1. Supabase Database & pgvector (Knowledge Base & Chat History)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 2. LLM & Embeddings (OpenAI / Groq)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-proj-your-openai-api-key-here

# Optional: Groq for ultra-fast Llama inference
# GROQ_API_KEY=gsk_your_groq_api_key

# ------------------------------------------------------------------------------
# 3. Redis Service (Internal Docker Network)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true

# ------------------------------------------------------------------------------
# 4. WhatsApp Gateway Inter-Service Communication
# ------------------------------------------------------------------------------
WHATSAPP_GATEWAY=baileys
WHATSAPP_GATEWAY_URL=http://whatsapp-gateway:3001
BACKEND_API_URL=http://backend:8000
AUTH_DIR=/data/auth_info_baileys

# ------------------------------------------------------------------------------
# 5. Frontend Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api
