# ==============================================================================
# DHOOD PLUS WHATSAPP AI AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
ENV=development
APP_NAME="Dhoodh Plus WhatsApp AI Agent"
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate_a_secure_random_key_here_for_admin_jwt
ADMIN_PASSWORD=change_this_admin_password_123

# Frontend URL (for CORS)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & VECTOR STORE
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Used for server-side trusted operations and pgvector queries (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional: public anon key if used directly
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 3. META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
# Set up in Meta Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_whatsapp_system_user_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# Custom verification token you define in Meta App Dashboard Webhook section
WHATSAPP_VERIFY_TOKEN=dhood_plus_secure_verify_token_2026
# WhatsApp Cloud API Version
WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Supported providers: "openai", "groq", "gemini", "ollama"
LLM_PROVIDER=openai
# OpenAI API Key (or Groq / Gemini key if selected)
LLM_API_KEY=sk-proj-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=3000

# ------------------------------------------------------------------------------
# 5. EMBEDDING PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Supported providers: "openai", "gemini", "local"
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-proj-your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 6. RAG RETRIEVAL CONFIGURATION
# ------------------------------------------------------------------------------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
MAX_HISTORY_MESSAGES=6

# ------------------------------------------------------------------------------
# 7. DOCUMENT INGESTION & STORAGE
# ------------------------------------------------------------------------------
UPLOAD_DIR=./storage/documents
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# 8. REDIS CACHE & STATE STORE (Auto-fallback to in-memory if offline)
# ------------------------------------------------------------------------------
REDIS_ENABLED=True
# In Render: set automatically via render.yaml or redis://red-xxx:6379
# In Localhost: redis://localhost:6379/0 (Leave empty for resilient in-memory cache)
REDIS_URL=

